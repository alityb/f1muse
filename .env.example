# F1 Muse API Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONNECTION (REQUIRED)
# =============================================================================

# Local PostgreSQL:
# DATABASE_URL=postgresql://readonly_user:password@localhost:5432/f1muse

# Supabase (SSL enabled automatically):
# DATABASE_URL=postgresql://user:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Note: URL-encode special characters in password: ! = %21, # = %23, $ = %24, * = %2A

# Test database (optional - defaults to DATABASE_URL):
# TEST_DATABASE_URL=postgresql://...

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

PORT=3000
NODE_ENV=production

# Write-capable weekly data sync is disabled unless explicitly enabled.
# AUTO_SYNC=false
# Startup catch-up is an independent write-capable opt-in and is ignored unless
# AUTO_SYNC=true.
# AUTO_SYNC_STARTUP_CATCH_UP=false

# Raw and verified F1QL program routes. Keep disabled until their reviewed
# canonical-view migrations and read-only grants are present.
# F1QL_ENABLED=false

# Permanently shadow-only translation route. This flag never enables execution.
# F1QL_TRANSLATION_ENABLED=false

# Separate stage-zero compositional semantic shadow. This route proposes and
# proves plans but never executes a planned result query.
# F1QL_SEMANTIC_SHADOW_ENABLED=false
# F1QL_SEMANTIC_SHADOW_KILL_SWITCH=true
# F1QL_SEMANTIC_SHADOW_STAGE=0
# F1QL_SEMANTIC_SHADOW_INTERNAL_TOKEN=replace-with-a-random-32-byte-secret
# F1QL_SEMANTIC_SHADOW_METADATA_STATEMENT_TIMEOUT_MS=5000
# F1QL_SEMANTIC_SHADOW_REQUEST_TIMEOUT_MS=15000
# Dedicated strict-schema provider. Supported values are `openai-compatible`
# and `anthropic`. Anthropic requires the exact base URL
# `https://api.anthropic.com/v1`. Literal IPs, private host suffixes, custom
# ports, redirects, and returned model substitutions are rejected.
# F1QL_SEMANTIC_CANDIDATE_LLM_PROVIDER=openai-compatible
# F1QL_SEMANTIC_CANDIDATE_LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# F1QL_SEMANTIC_CANDIDATE_LLM_API_KEY=provider-api-key
# F1QL_SEMANTIC_CANDIDATE_MODEL=accounts/fireworks/models/deepseek-v4-pro
# F1QL_SEMANTIC_CANDIDATE_MODEL_STRICT_JSON_SCHEMA=true
# F1QL_SEMANTIC_CANDIDATE_TIMEOUT_MS=30000
# Guarded single-request check against the first reviewed compositional case.
# This command accepts only the pinned Fireworks DeepSeek endpoint/model/request
# identity and never connects to the application or a database.
# F1QL_SEMANTIC_CANDIDATE_PROBE_ENABLED=false
# F1QL_SEMANTIC_CANDIDATE_PROBE_TARGET=disabled
# Guarded disposable-localhost evidence collection. Requires exactly three
# sequential observations for every reviewed compositional case.
# F1QL_SEMANTIC_SHADOW_COLLECTION_ENABLED=false
# F1QL_SEMANTIC_SHADOW_COLLECTION_TARGET=disabled
# F1QL_SEMANTIC_SHADOW_COLLECTION_REPETITIONS=3
# F1QL_SEMANTIC_SHADOW_COLLECTION_MIN_REQUEST_INTERVAL_MS=0
# Guarded builder for one signed principal audit and metadata audit plus one
# reviewed, runtime-attested, non-executing stage-zero semantic-shadow event.
# F1QL_SEMANTIC_SHADOW_PRODUCTION_EVIDENCE_BUILD_ENABLED=false
# F1QL_SEMANTIC_SHADOW_PRODUCTION_EVIDENCE_TARGET=disabled
# F1QL_SEMANTIC_SHADOW_PRODUCTION_CAPTURE_ENABLED=false
# F1QL_SEMANTIC_SHADOW_PRODUCTION_CAPTURE_TARGET=disabled
# F1QL_SEMANTIC_SHADOW_PRODUCTION_CAPTURE_NONCE=43-character-base64url-random-nonce
# Keep the capture private key only in the deployed runtime; the offline builder
# receives only its public key.
# F1QL_SEMANTIC_SHADOW_PRODUCTION_CAPTURE_KEY_ID=semantic-shadow-capture-key-id
# F1QL_SEMANTIC_SHADOW_PRODUCTION_CAPTURE_PRIVATE_KEY_BASE64=base64-pkcs8-ed25519-private-key
# F1QL_SEMANTIC_SHADOW_PRODUCTION_CAPTURE_PUBLIC_KEY_BASE64=base64-spki-ed25519-public-key
# Use a distinct offline Ed25519 key from the answer production-evidence key.
# F1QL_SEMANTIC_SHADOW_PRODUCTION_EVIDENCE_KEY_ID=semantic-shadow-evidence-key-id
# F1QL_SEMANTIC_SHADOW_PRODUCTION_EVIDENCE_PRIVATE_KEY_BASE64=base64-pkcs8-ed25519-private-key
# F1QL_SEMANTIC_SHADOW_PRODUCTION_EVIDENCE_PUBLIC_KEY_BASE64=base64-spki-ed25519-public-key

# Required in production for /admin/*.
# Send it as: Authorization: Bearer <ADMIN_API_KEY>
# ADMIN_API_KEY=replace-with-a-random-32-byte-secret

# =============================================================================
# STRICT F1QL ANSWER INTERPRETATION
# =============================================================================

# The answer interpreter may select only a closed AnswerIntent schema. It does
# not emit SQL or executable F1QL; server derivation and semantic proof remain
# authoritative. Provider configuration is answer-specific.
# F1QL_ANSWER_LLM_PROVIDER=groq
# F1QL_ANSWER_LLM_BASE_URL=https://api.groq.com/openai/v1
# F1QL_ANSWER_LLM_API_KEY=provider-api-key
# F1QL_ANSWER_MODEL=openai/gpt-oss-20b
# Required only for a reviewed non-Groq OpenAI-compatible strict-schema model.
# F1QL_ANSWER_MODEL_STRICT_JSON_SCHEMA=false

# Gated F1QL answer pipeline (disabled by default)
# F1QL_ANSWER_ENABLED=false
# Independent public rollout gate. Keep false during internal canaries.
# F1QL_PUBLIC_ANSWER_ENABLED=false
# F1QL_ANSWER_KILL_SWITCH=true
# Explicit host, port, role, and database are required; connection query overrides are rejected.
# F1QL_ANSWER_DATABASE_URL=postgresql://dedicated-read-only-answer-role@host:5432/database
# F1QL_ANSWER_INTERNAL_TOKEN=replace-with-a-random-32-byte-secret
# Optional distinct credential for an explicitly selected internal canary principal.
# F1QL_ANSWER_INTERNAL_CANARY_TOKEN=replace-with-a-different-random-32-byte-secret
# Staged deterministic rollout. Accepted stages: 0,1,5,25,50,100.
# F1QL_ANSWER_CANARY_STAGE=0
# Canonical Base64 for a dedicated 32-64 byte HMAC-SHA256 key. Never log this value.
# F1QL_ANSWER_CANARY_HMAC_KEY_BASE64=
# Base64-encoded trusted PEM CA for the dedicated production answer database. Required with F1QL_ANSWER_DATABASE_URL.
# F1QL_ANSWER_DATABASE_CA_CERT_BASE64=
# Optional provider request reasoning mode: none|minimal|low|medium|high|xhigh|max. Unset omits it and binds hardened evidence as disabled.
# F1QL_ANSWER_REASONING_EFFORT=
# Runtime gates. Defaults are conservative and every value has a fail-closed
# minimum/maximum; statement timeout may not exceed request timeout.
# F1QL_ANSWER_MAX_CONCURRENCY=2
# F1QL_ANSWER_QUEUE_TIMEOUT_MS=2000
# F1QL_ANSWER_REQUEST_TIMEOUT_MS=12000
# F1QL_ANSWER_RATE_LIMIT_MAX=10
# F1QL_ANSWER_RATE_LIMIT_WINDOW_MS=900000
# F1QL_ANSWER_STATEMENT_TIMEOUT_MS=3000
# F1QL_ANSWER_MAX_WORK_UNITS=2280
# F1QL_ANSWER_MAX_ROWS=100
# F1QL_ANSWER_MAX_RESPONSE_BYTES=65536

# Non-executing answer-evaluation artifact provenance
# F1QL_ANSWER_EVALUATION_KEY_ID=evaluation-key-id
# F1QL_ANSWER_EVALUATION_PRIVATE_KEY_BASE64=base64-pkcs8-ed25519-private-key
# F1QL_ANSWER_EVALUATION_PUBLIC_KEY_BASE64=base64-spki-ed25519-public-key
# Deterministic evidence collection requires both exact localhost guards.
# F1QL_ANSWER_DERIVATION_EVIDENCE_ENABLED=false
# F1QL_ANSWER_DERIVATION_EVIDENCE_TARGET=disabled
# Evaluation-only quota pacing between provider attempts; not production behavior and not a retry.
# F1QL_ANSWER_EVALUATION_MIN_REQUEST_INTERVAL_MS=0

# Guarded production principal audit and production evidence trust root
# F1QL_ANSWER_PRINCIPAL_AUDIT_ENABLED=false
# F1QL_ANSWER_PRINCIPAL_AUDIT_TARGET=disabled
# Guarded semantic-catalog binding audit; production only and never targets loopback.
# F1QL_SEMANTIC_CATALOG_AUDIT_ENABLED=false
# F1QL_SEMANTIC_CATALOG_AUDIT_TARGET=disabled
# F1QL_ANSWER_PRODUCTION_EVIDENCE_KEY_ID=production-evidence-key-id
# Private key is available only to the production audit/evidence signer.
# F1QL_ANSWER_PRODUCTION_EVIDENCE_PRIVATE_KEY_BASE64=base64-pkcs8-ed25519-private-key
# The release builder receives only the matching trusted public key.
# F1QL_ANSWER_PRODUCTION_EVIDENCE_PUBLIC_KEY_BASE64=base64-spki-ed25519-public-key
# Guarded signer consumes a passing principal audit and writes production evidence only.
# F1QL_ANSWER_PRODUCTION_EVIDENCE_BUILD_ENABLED=false
# F1QL_ANSWER_PRODUCTION_EVIDENCE_BUILD_TARGET=disabled

# Guarded release attestation build (offline evidence packaging only; no deploy)
# F1QL_ANSWER_RELEASE_BUILD_ENABLED=false
# F1QL_ANSWER_RELEASE_BUILD_TARGET=disabled
# F1QL_ANSWER_RELEASE_COMMIT_SHA=40-character-lowercase-git-commit
# F1QL_ANSWER_RELEASE_PRIVATE_KEY_BASE64=base64-pkcs8-ed25519-private-key
# F1QL_ANSWER_RELEASE_KEY_ID=release-key-id
# F1QL_ANSWER_AUTHORIZATION_AUDIENCE=f1muse-answer
# F1QL_ANSWER_DEPLOYMENT_ID=deployment-id
# F1QL_ANSWER_RELEASE_ID=release-id
# Highest canary stage authorized by the signed release: 0,1,5,25,50,100.
# F1QL_ANSWER_CANARY_MAXIMUM_STAGE=0
# F1QL_ANSWER_DEPLOYMENT_TEMPLATE_IDS=comma-separated-sorted-template-ids
# Signed routing mode. The release builder currently permits only template_only;
# shadow_compare and compositional_profiles remain blocked until their evidence packages exist.
# F1QL_ANSWER_ROUTING_MODE=template_only
# Sorted semantic capability profiles selected by a future compositional release; empty for template_only.
# F1QL_ANSWER_DEPLOYMENT_CAPABILITY_PROFILE_IDS=
# Sorted exact-template IDs migrated to a future compositional lane; empty for template_only.
# F1QL_ANSWER_MIGRATED_TEMPLATE_IDS=
# Sorted, unique signed principal classes: internal,internal_canary,public.
# Stage-zero/internal-canary releases should use internal_canary only. Public
# rollout requires a separately built attestation whose value includes public.
# F1QL_ANSWER_DEPLOYMENT_PRINCIPAL_CLASSES=internal_canary
# Signed attestation validity/freshness limits (defaults: 10 minutes / 5 minutes; maximum: 1 hour).
# F1QL_ANSWER_RELEASE_MAX_VALIDITY_MS=600000
# F1QL_ANSWER_RELEASE_MAX_AGE_MS=300000
# Required explicit evidence freshness limits for the offline release builder.
# F1QL_ANSWER_DERIVATION_EVIDENCE_MAX_AGE_MS=86400000
# F1QL_ANSWER_PRINCIPAL_AUDIT_MAX_AGE_MS=3600000

# Fail-closed attestation verification / route loading
# Exact signed JSON produced by the guarded release builder.
# F1QL_ANSWER_RELEASE_ATTESTATION={...}
# F1QL_ANSWER_RELEASE_PUBLIC_KEY_BASE64=base64-spki-ed25519-public-key
# F1QL_ANSWER_RELEASE_MANIFEST_SHA256=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_ARTIFACT_SHA256=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_REPORT_SHA256=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_RESULT_FIXTURE_SHA256=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_PRINCIPAL_AUDIT_SHA256=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_PRODUCTION_EVIDENCE_SHA256=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_SEMANTIC_CATALOG_HASH=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_SEMANTIC_CATALOG_DATABASE_BINDING_HASH=64-character-lowercase-sha256
# F1QL_ANSWER_RELEASE_SEMANTIC_CATALOG_BINDING_ARTIFACT_SHA256=64-character-lowercase-sha256

# =============================================================================
# REDIS RATE LIMITING (DISTRIBUTED WHEN CONFIGURED)
# =============================================================================

# Local Redis:
# REDIS_URL=redis://localhost:6379

# Redis with password:
# REDIS_URL=redis://:password@host:6379

# Production (Redis Cloud, AWS ElastiCache, etc.):
# REDIS_URL=redis://user:password@redis-host:6379

# =============================================================================
# DEVELOPER NOTES
# =============================================================================

# Using psql with .env:
#   The shell doesn't auto-load .env files. To use psql:
#
#   Option A - Export manually:
#     export $(grep -v '^#' .env | xargs)
#     psql "$DATABASE_URL" -c "select 1;"
#
#   Option B - One-liner:
#     eval $(grep DATABASE_URL .env) psql "$DATABASE_URL" -c "select 1;"
#
# SSL Notes:
#   - The dedicated answer database always verifies TLS against F1QL_ANSWER_DATABASE_CA_CERT_BASE64.
#   - URL SSL query parameters are ignored for the dedicated answer connection.

# =============================================================================
# ANSWER RELEASE MATERIAL
# =============================================================================
# Release attestation values are generated by the guarded release process.
# Never invent them, reuse evidence across commits, or place private signing
# keys in the deployed application environment.
