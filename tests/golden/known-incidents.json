{
  "version": 1,
  "cases": [
    {
      "id": "hamilton-2018-official-points",
      "title": "Hamilton 2018 uses official championship points",
      "incident": "Race-result sums and stale caches previously showed a non-official total.",
      "target": "api",
      "status": "verified",
      "query": "lewis hamilton 2018 season",
      "outcome": "answer",
      "authority": "season_driver_standing",
      "evidence": {
        "source": "jolpica",
        "reference": "https://api.jolpi.ca/ergast/f1/2018/driverstandings/?format=json&limit=100",
        "independently_verified": true,
        "snapshot": "tests/golden/snapshots/jolpica-2018-driverstandings.json"
      },
      "assertions": [
        { "subject": "lewis-hamilton", "metric": "championship_points", "equals": 408 },
        { "subject": "lewis-hamilton", "metric": "wins", "equals": 11 }
      ]
    },
    {
